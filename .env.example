GOOGLE_API_KEY=XXXX
GEMINI_MODEL=gemini-3.5-flash-lite

KALI_HOST=XX.XX.0.XX
KALI_PORT=22
KALI_USERNAME=israr
KALI_SSH_KEY=/home/israr/.ssh/pentaia_kali

# Local IPv4 address to use only when a predefined Phase 3 validation action
# explicitly requires a callback/listener address. This is not a target address.
# Leave blank when no supported action requires it.
PENTAIA_LHOST=

# TCP port on the PentAiA side used to receive the callback for a predefined
# Phase 3 validation action that establishes a reverse session. PentAiA owns and
# validates this value; it is never supplied by the model. Defaults to 4444.
#
# This is the single-port fallback. When PENTAIA_LPORT_MIN and PENTAIA_LPORT_MAX
# are both set below, PentAiA allocates from that pool instead.
PENTAIA_LPORT=

# Approved listener port pool for reverse-session validations. Set BOTH or
# neither. When set, PentAiA reserves the lowest free port for each pending
# proposal, shows it in the approval prompt, keeps it stable through execution,
# and releases it on reject, expiry, failure or completion. Concurrent
# validations against different targets receive different ports. The pool may
# hold at most 256 ports.
PENTAIA_LPORT_MIN=
PENTAIA_LPORT_MAX=

# Comma-separated additional IPv4 addresses that Nuclei must never scan.
# 172.16.0.1 is protected by default in code.
PENTAIA_NUCLEI_DENYLIST=

# Phase 3 is fail-closed. Only IPv4 addresses explicitly listed here may be
# used for human-approved state-changing validation actions.
PENTAIA_PHASE3_ALLOWLIST=

# Optional additional IPv4 addresses that Phase 3 must never target.
# 172.16.0.1 is protected by default in code and remains blocked even if
# someone accidentally adds it to PENTAIA_PHASE3_ALLOWLIST.
PENTAIA_PHASE3_DENYLIST=

# Phase 4 web application bind address. Loopback by default: the reverse proxy
# runs on the same host, so the application never needs a public interface.
PENTAIA_WEB_HOST=127.0.0.1
PENTAIA_WEB_PORT=8000

# Serve the interactive API documentation. Off by default because the OpenAPI
# document describes the whole browser-facing surface.
PENTAIA_WEB_DOCS=false

# Phase 4 authenticates the web application against exactly one identity provider.
# Supported values: ad, radius. Leave blank to run with no provider: the application
# serves /healthz, but nothing can authenticate and every /api route refuses. It never
# means anonymous access.
#
# ad     - Active Directory over LDAPS (implemented; configure PENTAIA_AD_* below).
# radius - recognised by the Phase 4 contract but not implemented yet (issue #56).
#          Selecting it fails startup closed; nothing is substituted for it.
PENTAIA_AUTH_PROVIDER=

# Application store mode. 'memory' (the default) keeps web sessions, login throttling and
# accounting in the process: nothing survives a restart, and it is the development and
# test mode. 'sqlite' is the operational mode and requires PENTAIA_DATA_DIR, which makes
# sessions, throttling and the accounting trail durable across restarts.
#
# In either mode an operation whose accounting event is marked *required* is refused when
# it cannot be committed, so a security-critical action cannot run unaccounted. In
# 'memory' mode there is no durable accounting at all, so such actions are refused.
PENTAIA_STORE_MODE=memory

# Directory holding the durable store (pentaia.db). Required when PENTAIA_STORE_MODE=sqlite.
# Created with owner-only permissions: 0700 for the directory, 0600 for the database and
# for the SQLite WAL sidecars. Back it up after a clean shutdown, or copy the -wal file
# too; a database copied while the application is running can be missing recent commits.
PENTAIA_DATA_DIR=

# How long SQLite waits for a lock before reporting the store as busy, in milliseconds.
PENTAIA_DB_BUSY_TIMEOUT_MS=5000

# Session timeouts in seconds. Idle defaults to 1800 (30 minutes) and the absolute
# lifetime to 43200 (12 hours). Activity refreshes the idle timer and never extends the
# absolute lifetime. The idle timeout must not exceed the absolute lifetime, and the
# absolute lifetime must be at least 300 seconds.
PENTAIA_SESSION_IDLE_TIMEOUT=1800
PENTAIA_SESSION_ABSOLUTE_LIFETIME=43200

# The origin this deployment is reachable at, for example
# https://pentaia.example.test. Setting it makes the browser's Origin header checked
# against the full origin, scheme and port included, without trusting Host or any
# forwarded header. Leave blank and only the host is compared, which is weaker; a
# deployed instance should set it.
PENTAIA_PUBLIC_ORIGIN=

# Addresses whose X-Forwarded-For header is believed. The reverse proxy runs on the
# same host, so loopback is the only default that trusts anything. Addresses or CIDR
# networks, comma separated. A wildcard is refused. Leave blank to trust no peer.
#
# The proxy MUST append the address it observed (nginx: $proxy_add_x_forwarded_for) or
# replace the header with $remote_addr. A proxy that forwards a client-supplied
# X-Forwarded-For unchanged makes login throttling key on an attacker-chosen value.
#
# The application bounds the login request body itself (64 KiB), declared or streamed, so
# a proxy body limit is defence in depth rather than the only control.
PENTAIA_TRUSTED_PROXIES=127.0.0.1

# Login throttling: failures allowed per username/address pair, the window they are
# counted in, and the maximum number of tracked keys. The per-address and per-username
# allowances are four times this value, so one host cannot spray usernames and many
# hosts cannot converge on one account. Raw usernames are never stored or logged; the
# keys are digests.
PENTAIA_LOGIN_MAX_ATTEMPTS=5
PENTAIA_LOGIN_WINDOW_SECONDS=900
PENTAIA_LOGIN_MAX_KEYS=10000

# Active Directory authentication over LDAPS. Use placeholders only: never commit
# a real domain, hostname, username, password or CA material.
#
# Phase 4 uses a direct-user bind, so no service account, base DN or search filter
# is needed. LDAPS is always used and certificate validation cannot be disabled:
# setting a variable that implies otherwise (for example PENTAIA_AD_VERIFY_TLS) is
# refused at startup rather than ignored.
PENTAIA_AD_HOST=dc01.example.test

# LDAPS port. Defaults to 636; plaintext LDAP is not supported.
PENTAIA_AD_PORT=636

# Optional private CA bundle for LDAPS. Leave blank to use the system trust store.
# The file must exist and be readable, otherwise startup fails closed.
PENTAIA_AD_CA_FILE=

# Bounded timeouts in seconds for connect and read. Both default to 5 and must be
# greater than 0 and at most 60.
PENTAIA_AD_CONNECT_TIMEOUT=5
PENTAIA_AD_RECEIVE_TIMEOUT=5
